---
// A single feed card: the <li> shell, the save button and the type-specific card.
// Also rendered with empty data inside <template>s so the client can clone saved cards
// from the exact same markup instead of building HTML strings.
import NewsCard from './NewsCard.astro';
import RepoCard from './RepoCard.astro';
import FeatureCard from './FeatureCard.astro';
import DevCard from './DevCard.astro';
import { getCardKey, type Card } from '../lib/cards';

interface Props {
	card: Card;
}

const { card } = Astro.props;
---

<li
	class={`reel-item type-${card.type}`}
	data-category={card.category}
	data-subcategory={card.subcategory}
	data-key={getCardKey(card) ?? ''}
	data-payload={encodeURIComponent(JSON.stringify(card))}
>
	<div class="reel-card">
		<div class="reel-card-wrapper">
			{card.type === 'news' && <NewsCard {...card.data} />}
			{card.type === 'github' && <RepoCard name={card.data.full_name} description={card.data.description} stars={card.data.stargazers_count} language={card.data.language} url={card.data.html_url} />}
			{card.type === 'chrome' && <FeatureCard id={card.data.id} name={card.data.name} summary={card.data.summary} category={card.data.category} status={card.data.status} />}
			{card.type === 'dev' && <DevCard title={card.data.title} url={card.data.url} reactions={card.data.reactions} author={card.data.author} />}
		</div>
		{/* Outside the tilting wrapper and after it: 3D-transformed boxes hit-test unreliably
		    (Chromium in multi-column layouts, WebKit ignoring z-index), which let taps fall through to the card link */}
		<button type="button" class="save-btn" aria-label="Save card" aria-pressed="false" title="Save this card">
			<svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
		</button>
	</div>
</li>
