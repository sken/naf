---
interface Props {
  title: string;
  url: string;
  reactions: number;
  author: string;
}
const { title, url, reactions, author } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="dev-card sound-trigger">
  <div class="content-overlay">
    <div class="card-header">
      <span class="category-badge">Dev.to</span>
      <span class="reactions">❤️ {reactions}</span>
    </div>
    
    <h3>{title}</h3>
    <p class="author">by {author}</p>
  </div>
</a>

<style is:global>
  .dev-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    flex: 1;
    width: 100%;
    text-decoration: none !important;
    color: var(--card-text);
    background: radial-gradient(ellipse at 50% -20%, var(--card-glow) 0%, transparent 70%);
    transition: background 0.3s ease;
  }

  .dev-card:hover {
    background: radial-gradient(ellipse at 50% -20%, var(--card-glow) 10%, transparent 80%);
  }

  .content-overlay {
    padding: 3.5rem 4.5rem 3rem 2rem;
  }

  .card-header {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .category-badge {
    color: var(--card-text);
    background: var(--card-glow);
    border: 1px solid var(--card-border);
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
  }

  .reactions {
    color: var(--card-accent);
    font-weight: 700;
  }

  h3 {
    font-size: 1.8rem;
    line-height: 1.35;
    margin: 0 0 0.5rem 0;
    text-wrap: balance;
  }

  .author {
    color: var(--card-text);
    opacity: 0.7;
    font-size: 0.95rem;
    margin: 0;
  }
</style>
