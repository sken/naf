---
interface Props {
  id: number | string;
  name: string;
  summary: string;
  status?: string;
  category?: string;
}

const { id, name, summary, status = "Unknown", category = "General" } = Astro.props;
---

<a href={`https://chromestatus.com/feature/${id}`} target="_blank" rel="noopener noreferrer" class="feature-card sound-trigger">
  <div class="content-overlay">
    <div class="card-header">
      <span class="category-badge">{category}</span>
      <span class="status-indicator">
        <span class="pulse"></span>
        {status}
      </span>
    </div>
    
    <h3>{name}</h3>
    <p>{summary}</p>
  </div>
</a>

<style is:global>
  .feature-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    flex: 1;
    width: 100%;
    text-decoration: none !important;
    color: var(--card-text);
    background: radial-gradient(ellipse at 50% -20%, var(--card-glow) 0%, transparent 70%);
    transition: background 0.3s ease;
  }

  .feature-card:hover {
    background: radial-gradient(ellipse at 50% -20%, var(--card-glow) 10%, transparent 80%);
  }

  .content-overlay {
    padding: 3.5rem 4.5rem 3rem 2rem;
  }

  .card-header {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .category-badge {
    color: var(--card-text);
    background: var(--card-glow);
    border: 1px solid var(--card-border);
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
  }

  .pulse {
    width: 6px;
    height: 6px;
    background: #38bdf8;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 8px #38bdf8;
    animation: pulse 2s infinite;
  }

  h3 {
    font-size: 1.8rem;
    line-height: 1.35;
    margin: 0 0 0.5rem 0;
    text-wrap: balance;
  }

  p {
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.9;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(56, 189, 248, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(56, 189, 248, 0); }
  }
</style>
