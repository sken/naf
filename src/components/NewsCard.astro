---
interface Props {
  title: string;
  link: string;
  date: string;
  source: string;
}
const { title, link, date, source } = Astro.props;
---

<a href={link} target="_blank" rel="noopener noreferrer" class="news-card sound-trigger">
  <div class="meta">
    <span class="source">{source}</span>
    <span class="date">{date}</span>
  </div>
  
  <h3>{title}</h3>
  
</a>

<style>
  .news-card {
    position: relative;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                border-color 0.3s ease,
                box-shadow 0.3s ease;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    height: 100%;
    text-decoration: none !important;
    color: var(--card-text);
    z-index: 1;
    
  }

  .news-card:hover {
    transform: translateY(-2px) scale(1.01);
    border-color: var(--card-accent);
    box-shadow: 0 8px 30px var(--card-glow);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    
    letter-spacing: 0.05em;
  }

  .source {
    color: var(--card-accent);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.3rem 0.6rem;
    border-radius: 8px;
  }

  .date {
    color: var(--card-text);
  }

  h3 {
    font-size: 1.1rem;
    color: var(--card-text);
    line-height: 1.5;
    margin: 0;
  }


  /* Phase 2: Elastic Component */
  @container bento (min-width: 450px) {
    h3 {
      font-size: 1.4rem;
      line-height: 1.4;
    }
  }

</style>
