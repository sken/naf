---
interface Props {
  title: string;
  link: string;
  date: string;
  source: string;
}
const { title, link, date, source } = Astro.props;
---

<a href={link} target="_blank" rel="noopener noreferrer" class="news-card sound-trigger">
  <div class="content-overlay">
    <div class="meta">
      <span class="source">{source}</span>
      <span class="date">{date}</span>
    </div>
    <h3>{title}</h3>
  </div>
</a>

<style is:global>
  .news-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    flex: 1;
    width: 100%;
    text-decoration: none !important;
    color: var(--card-text);
    background: radial-gradient(ellipse at 50% -20%, var(--card-glow) 0%, transparent 70%);
    transition: background 0.3s ease;
  }

  .news-card:hover {
    background: radial-gradient(ellipse at 50% -20%, var(--card-glow) 10%, transparent 80%);
  }

  .content-overlay {
    padding: 3.5rem 4.5rem 3rem 2rem;
  }

  .meta {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .source {
    color: var(--card-text);
    background: var(--card-glow);
    border: 1px solid var(--card-border);
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
  }

  h3 {
    font-size: 1.6rem;
    line-height: 1.35;
    margin: 0;
    text-wrap: balance;
  }
</style>
