---
interface Props {
  title: string;
  link: string;
  date: string;
  source: string;
}
const { title, link, date, source } = Astro.props;
---

<a href={link} target="_blank" rel="noopener noreferrer" class="news-card sound-trigger">
  <div class="meta">
    <span class="source">{source}</span>
    <span class="date">{date}</span>
  </div>
  
  <h3>{title}</h3>
  
</a>

<style>
  .news-card {
    position: relative;
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                border-color 0.3s ease,
                box-shadow 0.3s ease;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    height: 100%;
    text-decoration: none !important;
    color: inherit;
    z-index: 1;
    box-shadow: var(--coss-shadow);
  }

  .news-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.05), 0 10px 30px -10px var(--accent-glow);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .source {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
  }

  .date {
    color: var(--text-secondary);
  }

  h3 {
    font-size: 1.1rem;
    color: #fff;
    line-height: 1.5;
    margin: 0;
  }

</style>
