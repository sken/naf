---
// Generate a random seed for the SVG filters so the ink wobbles and watercolor bleeds change on every build!
const seed = Math.floor(Math.random() * 1000);
---
<svg class="hub-logo" viewBox="0 0 320 130" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Use the random seed in the ID and the seed attribute so it changes every build -->
    <filter id={`ink-${seed}`} x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" seed={seed} result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G" />
    </filter>
    
    <filter id={`watercolor-${seed}`} x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.015" numOctaves="4" seed={seed + 1} result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="8" xChannelSelector="R" yChannelSelector="G" />
      <feGaussianBlur stdDeviation="1.5" />
      <feComponentTransfer>
        <feFuncA type="linear" slope="0.85"/>
      </feComponentTransfer>
    </filter>
  </defs>

  <!-- Watercolor Fills -->
  <g filter={`url(#watercolor-${seed})`} style="mix-blend-mode: multiply;">
    <!-- H -->
    <g transform="translate(0, 5) scale(0.95) rotate(-2, 55, 60)">
      <path d="M 20 20 L 25 100 L 45 100 L 42 75 L 75 70 L 72 100 L 92 100 L 95 20 L 75 20 L 72 50 L 42 55 L 40 20 Z" fill="#DE826D" />
    </g>
    <!-- U (Widened) -->
    <g transform="translate(-10, -5) scale(1.08) rotate(3, 155, 60)">
      <path d="M 115 20 L 120 90 C 125 110 175 110 180 90 L 185 20 L 160 20 L 158 85 C 158 98 142 98 142 85 L 140 20 Z" fill="#6B87A3" />
    </g>
    <!-- B -->
    <g transform="translate(5, 8) scale(0.92) rotate(-1, 240, 60)">
      <path d="M 210 20 L 210 100 L 255 100 C 285 100 285 55 250 55 C 275 55 275 20 250 20 Z M 230 35 L 245 35 C 255 35 255 45 245 45 L 230 45 Z M 230 70 L 250 70 C 265 70 265 85 250 85 L 230 85 Z" fill="#DE826D" />
    </g>
  </g>

  <!-- Ink Splatters (Background) -->
  <g fill="#1A1A24" opacity="0.6">
    <circle cx="15" cy="40" r="1.5" />
    <circle cx="20" cy="80" r="1" />
    <circle cx="105" cy="30" r="2" />
    <circle cx="110" cy="90" r="1.5" />
    <circle cx="200" cy="20" r="1" />
    <circle cx="290" cy="80" r="2" />
    <circle cx="260" cy="10" r="1.5" />
    <circle cx="80" cy="120" r="1" />
  </g>

  <!-- Messy Ink Outlines -->
  <g filter={`url(#ink-${seed})`} fill="none" stroke="#1A1A24" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <!-- H -->
    <g transform="translate(0, 5) scale(0.95) rotate(-2, 55, 60)">
      <path d="M 20 20 L 25 100 L 45 100 L 42 75 L 75 70 L 72 100 L 92 100 L 95 20 L 75 20 L 72 50 L 42 55 L 40 20 Z" />
      <path d="M 18 22 L 23 98 M 47 100 L 44 72 M 73 22 L 70 100 M 38 55 L 75 48" stroke-width="1.5" opacity="0.7"/>
    </g>
    <!-- U (Widened) -->
    <g transform="translate(-10, -5) scale(1.08) rotate(3, 155, 60)">
      <path d="M 115 20 L 120 90 C 125 110 175 110 180 90 L 185 20 L 160 20 L 158 85 C 158 98 142 98 142 85 L 140 20 Z" />
      <path d="M 113 22 L 118 88 M 187 90 L 183 18 M 158 20 L 156 85 M 138 22 L 140 85" stroke-width="1.5" opacity="0.7"/>
    </g>
    <!-- B -->
    <g transform="translate(5, 8) scale(0.92) rotate(-1, 240, 60)">
      <path d="M 210 20 L 210 100 L 255 100 C 285 100 285 55 250 55 C 275 55 275 20 250 20 Z M 230 35 L 245 35 C 255 35 255 45 245 45 L 230 45 Z M 230 70 L 250 70 C 265 70 265 85 250 85 L 230 85 Z" />
      <path d="M 208 22 L 208 98 M 212 102 L 258 100 M 248 18 L 212 22 M 228 35 L 245 38 M 228 72 L 250 75" stroke-width="1.5" opacity="0.7"/>
    </g>
  </g>

  <!-- More Ink Splatters (Foreground) -->
  <g fill="#1A1A24">
    <circle cx="35" cy="25" r="0.8" />
    <circle cx="40" cy="20" r="1.2" />
    <circle cx="160" cy="85" r="1" />
    <circle cx="185" cy="60" r="1.5" />
    <circle cx="230" cy="45" r="1" />
    <circle cx="275" cy="35" r="0.8" />
  </g>
</svg>

<style>
  .hub-logo {
    height: 110px;
    width: auto;
    display: block;
    margin: 0 auto;
  }
</style>
