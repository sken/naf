---
interface Props {
  name: string;
  description: string;
  stars: number;
  language: string;
  url: string;
}
const { name, description, stars, language, url } = Astro.props;
const formattedStars = new Intl.NumberFormat('en-US').format(stars);
---

<a href={url} target="_blank" rel="noopener noreferrer" class="repo-card sound-trigger">
  <div class="content-overlay">
    <div class="card-header">
      <span class="category-badge">{language || 'Code'}</span>
      <span class="stars">{formattedStars} Stars</span>
    </div>
    
    <h3>{name}</h3>
    <p>{description || 'No description provided.'}</p>
  </div>
</a>

<style is:global>
  .repo-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    flex: 1;
    width: 100%;
    text-decoration: none !important;
    color: var(--card-text);
    background: radial-gradient(ellipse at 50% -20%, var(--card-glow) 0%, transparent 70%);
    transition: background 0.3s ease;
  }

  .repo-card:hover {
    background: radial-gradient(ellipse at 50% -20%, var(--card-glow) 10%, transparent 80%);
  }

  .content-overlay {
    padding: 3.5rem 4.5rem 3rem 2rem;
  }

  .card-header {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .category-badge, .stars {
    color: var(--card-text);
    background: var(--card-glow);
    border: 1px solid var(--card-border);
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
  }

  h3 {
    font-size: 1.8rem;
    line-height: 1.35;
    margin: 0 0 0.5rem 0;
    text-wrap: balance;
  }

  p {
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.9;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
