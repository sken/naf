---
import Layout from '../layouts/Layout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import NewsCard from '../components/NewsCard.astro';
import TrendCard from '../components/TrendCard.astro';
import RepoCard from '../components/RepoCard.astro';
import Parser from 'rss-parser';
import * as cheerio from 'cheerio';

// 1. Fetch data from the Chrome Status API during the build process
let features: any[] = [];

try {
  const response = await fetch('https://chromestatus.com/api/v0/features');
  if (response.ok) {
    let text = await response.text();
    // ChromeStatus API uses )]}' to prevent JSON hijacking (XSSI)
    if (text.startsWith(")]}'")) {
      text = text.substring(4).trim();
    }
    const data = JSON.parse(text);
    // API returns an object with a "features" array
    if (data && Array.isArray(data.features)) {
      features = data.features.slice(0, 12); // Get top 12 latest features
    }
  } else {
    console.error('Failed to fetch features:', response.status);
  }
} catch (e) {
  console.error('Error fetching data:', e);
}

// Extract unique statuses for the filter dropdown
const uniqueStatuses = [...new Set(features.map(f => f.browsers?.chrome?.status?.text || "In Development"))].sort();

// 2. Fetch RSS feeds for industry news
let newsItems: any[] = [];
try {
  const parser = new Parser();
  const sources = [
    { url: 'https://www.smashingmagazine.com/feed', name: 'Smashing Mag' },
    { url: 'https://blog.logrocket.com/feed/', name: 'LogRocket' },
    { url: 'https://web.dev/feed.xml', name: 'Web.dev' },
    { url: 'https://javascriptweekly.com/rss/', name: 'JS Weekly' },
    { url: 'https://medium.com/feed/tag/web-development', name: 'Medium (Web)' },
    { url: 'https://medium.com/feed/tag/spec-driven-development', name: 'Medium (Spec)' },
    { url: 'https://medium.com/feed/tag/ai-agents', name: 'Medium (AI)' },
    { url: 'https://github.blog/category/ai/feed/', name: 'GitHub AI' }
  ];

  for (const source of sources) {
    try {
      const feed = await parser.parseURL(source.url);
      const items = feed.items.slice(0, 3).map(item => ({
        title: item.title,
        link: item.link,
        pubDateObj: new Date(item.pubDate || item.isoDate || ''),
        date: new Date(item.pubDate || item.isoDate || '').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
        source: source.name
      }));
      newsItems = [...newsItems, ...items];
    } catch (err) {
      console.error(`Error fetching ${source.name}:`, err);
    }
  }

  // Sort by date, newest first
  newsItems.sort((a, b) => b.pubDateObj.getTime() - a.pubDateObj.getTime());
  
  // Take top 12 for the grid
  newsItems = newsItems.slice(0, 12);
} catch (e) {
  console.error('Error fetching RSS:', e);
}

const uniqueSources = [...new Set(newsItems.map(n => n.source))].sort();

// 3. Fetch GitHub Exploring Trends directly from the trending page
let githubRepos: any[] = [];
try {
  const res = await fetch('https://github.com/trending', {
    headers: { 'User-Agent': 'Astro-Dashboard' }
  });
  if (res.ok) {
    const html = await res.text();
    const $ = cheerio.load(html);
    $('article.Box-row').each((i, el) => {
      if(i >= 6) return;
      const title = $(el).find('h2 a').text().replace(/\s+/g, '').trim();
      const url = 'https://github.com/' + title;
      const description = $(el).find('p').text().trim();
      const language = $(el).find('[itemprop="programmingLanguage"]').text().trim();
      const starsStr = $(el).find('a[href$="/stargazers"]').first().text().trim().replace(/,/g, '');
      githubRepos.push({ 
        full_name: title, 
        html_url: url, 
        description, 
        language, 
        stargazers_count: parseInt(starsStr, 10) || 0 
      });
    });
  }
} catch (e) {
  console.error('Error fetching GitHub stats:', e);
}

// 4. Fetch NPM download stats for popular frameworks
let npmStats: any[] = [];
try {
  const frameworks = ['react', 'next', 'astro', 'svelte'];
  for (const fw of frameworks) {
    const res = await fetch(`https://api.npmjs.org/downloads/point/last-week/${fw}`);
    if (res.ok) {
      const data = await res.json();
      npmStats.push({ framework: data.package, downloads: data.downloads });
    }
  }
  // Sort by downloads descending
  npmStats.sort((a, b) => b.downloads - a.downloads);
} catch (e) {
  console.error('Error fetching NPM stats:', e);
}
---

<Layout title="Naf | Skendlab">
	<main class="dashboard">
		<header class="hero">
			<div class="badge">naf.skendlab.de</div>
			<h1>Naf</h1>
			<p>The central hub for industry insights, platform features, and emerging web trends.</p>
		</header>

		<section class="dashboard-section">
			<div class="section-header">
				<h2>Industry Insights</h2>
				<p>Latest architectural deep-dives from top engineering resources.</p>
			</div>
			
			<div class="filter-container">
				<div class="filter-pills">
					<button class="news-filter-pill active sound-trigger" data-filter="all">All Sources</button>
					{uniqueSources.map((src: any) => (
						<button class="news-filter-pill sound-trigger" data-filter={src}>{src}</button>
					))}
				</div>
			</div>

			<div class="news-grid" id="news-grid">
				{newsItems.map(news => (
					<div class="news-item" data-source={news.source}>
						<NewsCard title={news.title} link={news.link} date={news.date} source={news.source} />
					</div>
				))}
			</div>
		</section>

		<section class="dashboard-section">
			<div class="section-header">
				<h2>GitHub Explore Trends</h2>
				<p>The most starred repositories created within the last 7 days.</p>
			</div>
			<div class="news-grid">
				{githubRepos.map(repo => (
					<RepoCard 
						name={repo.full_name} 
						description={repo.description} 
						stars={repo.stargazers_count} 
						language={repo.language}
						url={repo.html_url} 
					/>
				))}
			</div>
		</section>

		<section class="dashboard-section">
			<div class="section-header">
				<h2>Chrome Platform Status</h2>
				<p>Upcoming features currently in development or recently shipped in Chromium.</p>
			</div>
			<div class="filter-container">
				<div class="filter-pills">
					<button class="filter-pill active sound-trigger" data-filter="all">All Features</button>
					{uniqueStatuses.map((status: any) => (
						<button class="filter-pill sound-trigger" data-filter={status}>{status}</button>
					))}
				</div>
			</div>

			<div class="features-grid" id="features-grid">
				{features.length > 0 ? (
					features.map((f: any) => (
						<div class="feature-item" data-status={f.browsers?.chrome?.status?.text || "In Development"}>
							<FeatureCard 
								id={f.id}
								name={f.name}
								summary={f.summary}
								category={f.category}
								status={f.browsers?.chrome?.status?.text || "In Development"}
							/>
						</div>
					))
				) : (
					<div class="loading-state">
						<p>Unable to load features at this time.</p>
					</div>
				)}
			</div>
		</section>

		<section class="dashboard-section">
			<div class="section-header">
				<h2>Weekly Framework Downloads</h2>
				<p>Live NPM registry data tracking ecosystem adoption over the last 7 days.</p>
			</div>
			<div class="trends-grid">
				{npmStats.map(stat => (
					<TrendCard framework={stat.framework} downloads={stat.downloads} />
				))}
			</div>
		</section>
	</main>
</Layout>

<script>
	const filterPills = document.querySelectorAll('.filter-pill');
	const items = document.querySelectorAll('.feature-item');
	const newsFilterPills = document.querySelectorAll('.news-filter-pill');
	const newsItemsList = document.querySelectorAll('.news-item');

	newsFilterPills.forEach(pill => {
		pill.addEventListener('click', (e) => {
			newsFilterPills.forEach(p => p.classList.remove('active'));
			const clickedPill = e.target as HTMLButtonElement;
			clickedPill.classList.add('active');

			const selectedSource = clickedPill.dataset.filter;
			
			newsItemsList.forEach(item => {
				const htmlItem = item as HTMLElement;
				if (selectedSource === 'all' || htmlItem.dataset.source === selectedSource) {
					htmlItem.style.display = 'block';
					htmlItem.style.animation = 'none';
					setTimeout(() => {
						htmlItem.style.animation = 'fadeIn 0.4s ease forwards';
					}, 10);
				} else {
					htmlItem.style.display = 'none';
				}
			});
		});
	});

	filterPills.forEach(pill => {
		pill.addEventListener('click', (e) => {
			// Update active state
			filterPills.forEach(p => p.classList.remove('active'));
			const clickedPill = e.target as HTMLButtonElement;
			clickedPill.classList.add('active');

			const selectedStatus = clickedPill.dataset.filter;
			
			items.forEach(item => {
				const htmlItem = item as HTMLElement;
				if (selectedStatus === 'all' || htmlItem.dataset.status === selectedStatus) {
					htmlItem.style.display = 'block';
					// Reset and trigger animation
					htmlItem.style.animation = 'none';
					setTimeout(() => {
						htmlItem.style.animation = 'fadeIn 0.4s ease forwards';
					}, 10);
				} else {
					htmlItem.style.display = 'none';
				}
			});
		});
	});
</script>

<style>
	.dashboard {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}

	.hero {
		text-align: center;
		margin-bottom: 4rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.badge {
		background: rgba(255, 255, 255, 0.1);
		padding: 0.5rem 1rem;
		border-radius: 20px;
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		border: 1px solid var(--border-color);
	}

	h1 {
		font-size: 4rem;
		font-weight: 700;
		line-height: 1.1;
		margin: 0;
	}

	.text-gradient {
		color: var(--text-primary);
	}

	.hero p {
		color: var(--text-secondary);
		font-size: 1.25rem;
		max-width: 600px;
		line-height: 1.6;
	}

	.dashboard-section {
		margin-bottom: 6rem;
		position: relative;
	}

	.section-header {
		margin-bottom: 2.5rem;
	}

	.section-header h2 {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
		color: #fff;
	}

	.section-header p {
		color: var(--text-secondary);
		font-size: 1.1rem;
	}

	.trends-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1.5rem;
	}

	.news-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 1.5rem;
	}

	.filter-container {
		display: flex;
		justify-content: center;
		margin-bottom: 3rem;
		width: 100%;
	}

	.filter-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
		background: rgba(255, 255, 255, 0.03);
		padding: 0.5rem;
		border-radius: 100px;
		border: 1px solid var(--border-color);
		backdrop-filter: blur(10px);
	}

	.filter-pill, .news-filter-pill {
		background: transparent;
		border: none;
		color: var(--text-secondary);
		padding: 0.5rem 1.25rem;
		border-radius: 100px;
		font-family: 'Inter', sans-serif;
		font-size: 0.9rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.filter-pill:hover, .news-filter-pill:hover {
		color: var(--text-primary);
		background: rgba(255, 255, 255, 0.05);
	}

	.filter-pill.active, .news-filter-pill.active {
		background: var(--text-primary);
		color: var(--bg-color);
		box-shadow: 0 4px 15px rgba(255, 255, 255, 0.05);
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 2rem;
	}

	.feature-item, .news-item {
		height: 100%;
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.loading-state {
		grid-column: 1 / -1;
		text-align: center;
		padding: 4rem;
		color: var(--text-secondary);
		background: var(--surface-color);
		border-radius: 16px;
		border: 1px solid var(--border-color);
	}

	@media (max-width: 768px) {
		h1 {
			font-size: 2.5rem;
		}
		.dashboard {
			padding: 2rem 1.5rem;
		}
	}
</style>
