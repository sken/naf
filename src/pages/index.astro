---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import NewsCard from '../components/NewsCard.astro';
import TrendCard from '../components/TrendCard.astro';
import RepoCard from '../components/RepoCard.astro';
import HubLogo from '../components/HubLogo.astro';
import DevCard from '../components/DevCard.astro';
import Parser from 'rss-parser';
import * as cheerio from 'cheerio';
import config from '../../hub.config.json';

// 1. Fetch data from the Chrome Status API
let features: any[] = [];
try {
  const response = await fetch(config.endpoints.chromeStatus);
  if (response.ok) {
    let text = await response.text();
    if (text.startsWith(")]}'")) text = text.substring(4).trim();
    const data = JSON.parse(text);
    if (data && Array.isArray(data.features)) {
      features = data.features.slice(0, config.limits.chromeFeatures);
    }
  }
} catch (e) {
  console.error('Error fetching features:', e);
}

// 2. Fetch RSS feeds for industry news
let newsItems: any[] = [];
try {
  const parser = new Parser();
  let guaranteedItems: any[] = [];
  let poolItems: any[] = [];
  
  for (const source of config.rssSources) {
    try {
      const feed = await parser.parseURL(source.url);
      let filteredItems = feed.items;

      // Filter out coupons/promos from Wired
      if (source.name.startsWith('Wired') || source.name.includes('Wired')) {
        filteredItems = filteredItems.filter(item => {
          if (!item.title) return false;
          const lowerTitle = item.title.toLowerCase();
          return !lowerTitle.includes('coupon') && !lowerTitle.includes('promo') && !lowerTitle.includes('codes');
        });
      }

      // Filter Medium articles to ONLY English and high signal
      if (source.name.startsWith('Medium')) {
        // Exclude Cyrillic, CJK, Arabic, etc.
        const nonEngChars = /[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\u0400-\u04ff\u0600-\u06ff]/;
        // Exclude common foreign stopwords (Spanish, Portuguese, German, French)
        const foreignWords = /\b(como|para|el|la|en|que|los|las|una|con|por|uma|da|do|na|no|der|die|das|les|des)\b/i;
        // Clickbait and spam filters
        const clickbait = /\b(jasa|top \d+|stop using|you need to)\b/i;
        
        filteredItems = filteredItems.filter(item => {
          if (!item.title) return false;
          if (nonEngChars.test(item.title)) return false;
          
          // Drop ALL CAPS SPAM (e.g., JASA WEBSITE...)
          const lettersOnly = item.title.replace(/[^a-zA-Z]/g, '');
          if (lettersOnly.length > 10 && lettersOnly === lettersOnly.toUpperCase()) return false;
          
          // Drop clickbait patterns
          if (clickbait.test(item.title)) return false;
          
          const matches = item.title.match(foreignWords) || [];
          if (matches.length >= 2) return false; // Reject if title has multiple foreign stop words

          // Word count heuristic
          const content = item['content:encoded'] || item.content || item.contentSnippet || '';
          const textOnly = content.replace(/<[^>]*>?/gm, ' ');
          const wordCount = textOnly.trim().split(/\s+/).length;
          
          // Drop suspiciously short articles
          if (wordCount < 500) return false;
          
          return true;
        });
      }

      // Map all items to a standardized format
      const items = filteredItems.map(item => ({
        title: item.title,
        link: item.link,
        pubDateObj: new Date(item.pubDate || item.isoDate || ''),
        date: new Date(item.pubDate || item.isoDate || '').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
        source: source.name
      }));
      
      // Extract exactly 2 items for the guaranteed list
      guaranteedItems = [...guaranteedItems, ...items.slice(0, 2)];
      // Push the rest into the general chronological pool
      poolItems = [...poolItems, ...items.slice(2)];
    } catch (err) {}
  }
  
  // Sort the general pool by most recent
  poolItems.sort((a, b) => b.pubDateObj.getTime() - a.pubDateObj.getTime());
  
  // Calculate remaining slots based on config limit
  const remainingQuota = Math.max(0, config.limits.rssNews - guaranteedItems.length);
  
  // Combine guaranteed items with the absolute newest items from the pool
  newsItems = [...guaranteedItems, ...poolItems.slice(0, remainingQuota)];
  
  // Final sort to display them chronologically in the UI
  newsItems.sort((a, b) => b.pubDateObj.getTime() - a.pubDateObj.getTime());
} catch (e) {}

// 3. Fetch GitHub Exploring Trends
let githubRepos: any[] = [];
try {
  const res = await fetch(config.endpoints.githubTrending, {
    headers: { 'User-Agent': 'Astro-Dashboard' }
  });
  if (res.ok) {
    const html = await res.text();
    const $ = cheerio.load(html);
    $('article.Box-row').each((i, el) => {
      if(i >= config.limits.githubTrending) return;
      const title = $(el).find('h2 a').text().replace(/\s+/g, '').trim();
      const url = 'https://github.com/' + title;
      const description = $(el).find('p').text().trim();
      const language = $(el).find('[itemprop="programmingLanguage"]').text().trim();
      const starsStr = $(el).find('a[href$="/stargazers"]').first().text().trim().replace(/,/g, '');
      githubRepos.push({ 
        full_name: title, 
        html_url: url, 
        description, 
        language, 
        stargazers_count: parseInt(starsStr, 10) || 0 
      });
    });
  }
} catch (e) {}

// Fetch user's starred repos
try {
  const starredRes = await fetch(`https://api.github.com/users/${config.githubUser}/starred`, {
    headers: { 'User-Agent': 'Astro-Dashboard' }
  });
  if (starredRes.ok) {
    const starredData = await starredRes.json();
    starredData.slice(0, config.limits.githubStarred).forEach((repo: any) => {
      githubRepos.push({
        full_name: repo.full_name,
        html_url: repo.html_url,
        description: repo.description,
        language: repo.language || 'Unknown',
        stargazers_count: repo.stargazers_count,
        isStarred: true
      });
    });
  }
} catch (e) {
  console.error('Error fetching starred repos:', e);
}

// 4. Fetch Dev.to Trending Articles
let devItems: any[] = [];
try {
  const devRes = await fetch(config.endpoints.devTo);
  if (devRes.ok) {
    const articles = await devRes.json();
    devItems = articles.slice(0, config.limits.devToArticles).map((article: any) => ({
      title: article.title,
      url: article.url,
      reactions: article.positive_reactions_count,
      author: article.user.name
    }));
  }
} catch (e) {
  console.error('Error fetching Dev.to:', e);
}
// 5. Fetch NPM download stats
let npmStats: any[] = [];
try {
  const frameworks = config.frameworks;
  for (const framework of frameworks) {
    const res = await fetch(`${config.endpoints.npmDownloads}${framework}`);
    if (res.ok) {
      const data = await res.json();
      npmStats.push({ framework: data.package, downloads: data.downloads });
    }
  }
  npmStats.sort((a, b) => b.downloads - a.downloads);
} catch (e) {}

// Combine essential items into the unified canvas (NPM stats moved to footer)
const allItems = [
  ...newsItems.map(n => {
     let sub = n.source.toLowerCase().replace(/[^a-z0-9]/g, '');
     if (n.source.includes('Medium')) sub = 'medium';
     return { type: 'news', category: 'articles', subcategory: sub, data: n };
  }),
  ...githubRepos.map(r => ({ type: 'github', category: 'repos', subcategory: r.isStarred ? 'starred' : 'trending', data: r })),
  ...features.map(f => ({ type: 'chrome', category: 'platform', subcategory: 'all', data: f })),
  ...devItems.map(d => ({ type: 'dev', category: 'articles', subcategory: 'devto', data: d }))
];

// Phase 1: Intelligent Sizing Algorithm
// Analyzes the actual content weight to determine how much horizontal grid space it needs
// Vertical space is now handled automatically by the Masonry script.
function getSpanClass(item: any) {
  if (item.type === 'npm') return ""; // NPM stats are just numbers, keep 1x1

  if (item.type === 'github') {
    return "span-2"; 
  }

  if (item.type === 'news') {
    // Long headlines need horizontal breathing room
    if (item.data.title.length > 65) return "span-2";
  }

  if (item.type === 'dev') {
    if (item.data.title && item.data.title.length > 70) return "span-2";
    return "";
  }

  if (item.type === 'chrome') {
    return "span-2";
  }

  return "";
}

// Shuffle array deterministically for the build
let shuffled = allItems.filter(i => !(i.type === 'github' && i.data.language === 'Starred')).sort(() => 0.5 - Math.random());
const starredItems = allItems.filter(i => i.type === 'github' && i.data.isStarred);

// Ensure starred repos are ALWAYS prominently included near the top of the canvas
starredItems.forEach((item, i) => {
  const insertIndex = Math.floor(Math.random() * (i + 5)); // Inject randomly into the first 15 slots
  shuffled.splice(insertIndex, 0, item);
});

---

<Layout title="Hub by Stefan Kendlbacher | Web Trends Dashboard">
	<main class="dashboard">


		<!-- Unified Master Filter -->
		<ul role="list" class="reel-feed">
			<!-- Intro Slide with Hero and Filters -->
			<li class="reel-item intro-slide">
				<header class="hero">
					<div class="badge">hub.skendlba.dev</div>
					<h1><HubLogo /></h1>
					<p>All the frontend signals you (or at least me) care about, minus the 45 open browser tabs.</p>
				</header>

				<div class="filter-container">
					<div class="filter-header">
						<div class="filter-pills">
							<button class="master-filter active sound-trigger" data-filter="all">All Signals</button>
							<button class="master-filter filter-articles sound-trigger" data-filter="articles">Articles</button>
							<button class="master-filter filter-repos sound-trigger" data-filter="repos">Repositories</button>
							<button class="master-filter filter-platform sound-trigger" data-filter="platform">Platform Updates</button>
						</div>
						<button class="saved-toggle sound-trigger" id="savedToggle" title="View Saved Cards">
							<svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
							Saved
						</button>
					</div>

					<div class="sub-filter-pills" data-parent="articles" style="display: none;">
						<button class="sub-filter active sound-trigger" data-subfilter="all">All Articles</button>
						<button class="sub-filter sound-trigger" data-subfilter="devto">Dev.to</button>
						<button class="sub-filter sound-trigger" data-subfilter="medium">Medium</button>
						{Array.from(new Set(config.rssSources.filter(s => !s.name.includes('Medium')).map(s => s.name))).map(name => (
							<button class="sub-filter sound-trigger" data-subfilter={name.toLowerCase().replace(/[^a-z0-9]/g, '')}>{name}</button>
						))}
					</div>
					<div class="sub-filter-pills" data-parent="repos" style="display: none;">
						<button class="sub-filter active sound-trigger" data-subfilter="all">All Repos</button>
						<button class="sub-filter sound-trigger" data-subfilter="trending">Trending</button>
						<button class="sub-filter sound-trigger" data-subfilter="starred">My Stars</button>
					</div>
				</div>
			</li>

			<!-- Reel Items Canvas -->
			{shuffled.map((item, i) => {
				return (
					<li 
						class={`reel-item type-${item.type}`} 
						data-category={item.category}
						data-subcategory={item.subcategory}
						data-payload={encodeURIComponent(JSON.stringify(item))}
					>
						<div class="reel-card-wrapper">
							<button class="save-btn" title="Save this card" onclick={`window.saveCard(this.closest('.reel-item'))`}>
								<svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
							</button>
							{item.type === 'news' && <NewsCard {...item.data} />}
							{item.type === 'github' && <RepoCard name={item.data.full_name} description={item.data.description} stars={item.data.stargazers_count} language={item.data.language} url={item.data.html_url} />}
							{item.type === 'chrome' && <FeatureCard id={item.data.id} name={item.data.name} summary={item.data.summary} category={item.data.category} status={item.data.browsers?.chrome?.status?.text || "In Development"} />}
							{item.type === 'dev' && <DevCard title={item.data.title} url={item.data.url} reactions={item.data.reactions} author={item.data.author} />}
						</div>
					</li>
				)
			})}
		</ul>

		<!-- Framework Stats Footer -->
		<section class="stats-footer">
			<h2>Weekly Framework Adoption</h2>
			<ul role="list" class="footer-bento">
				{npmStats.map(stat => (
					<li class="bento-item type-npm">
						<TrendCard framework={stat.framework} downloads={stat.downloads} />
					</li>
				))}
			</ul>
		</section>
	</main>
</Layout>

<script>
	const filters = document.querySelectorAll('.master-filter');
	const subFilters = document.querySelectorAll('.sub-filter');
	const subFilterRows = document.querySelectorAll('.sub-filter-pills');
	const savedToggle = document.getElementById('savedToggle');
	let activeCategory = 'all';
	let activeSubcategory = 'all';
	let isSavedViewActive = false;

	const updateDOM = async () => {
		if (isSavedViewActive) {
			await window.loadSavedCards();
		} else {
			// Clean up dynamically injected saved cards when disabling the view
			document.querySelectorAll('.reel-item[data-is-saved-card="true"]').forEach(el => el.remove());
		}
		
		const currentItems = document.querySelectorAll('.reel-item:not(.intro-slide)');
		currentItems.forEach(item => {
			const htmlItem = item as HTMLElement;
			const itemCat = htmlItem.dataset.category;
			const itemSub = htmlItem.dataset.subcategory;
			const isSavedCard = htmlItem.dataset.isSavedCard === 'true';
			
			const catMatch = activeCategory === 'all' || itemCat === activeCategory;
			const subMatch = activeCategory === 'all' || activeSubcategory === 'all' || itemSub === activeSubcategory;
			const viewMatch = isSavedViewActive ? isSavedCard : !isSavedCard;

			if (catMatch && subMatch && viewMatch) {
				htmlItem.style.display = 'flex';
			} else {
				htmlItem.style.display = 'none';
			}
		});
	};

	const triggerTransition = () => {
		if (document.startViewTransition) {
			document.startViewTransition(updateDOM);
		} else {
			updateDOM();
		}
	};

	filters.forEach(filter => {
		filter.addEventListener('click', (e) => {
			filters.forEach(f => f.classList.remove('active'));
			const clickedPill = e.target as HTMLButtonElement;
			clickedPill.classList.add('active');

			activeCategory = clickedPill.dataset.filter;
			activeSubcategory = 'all';

			// Toggle sub-filters
			subFilterRows.forEach(row => {
				const htmlRow = row as HTMLElement;
				if (htmlRow.dataset.parent === activeCategory) {
					htmlRow.style.display = 'flex';
					// Reset visual active state to "All"
					htmlRow.querySelectorAll('.sub-filter').forEach(btn => {
						if ((btn as HTMLElement).dataset.subfilter === 'all') btn.classList.add('active');
						else btn.classList.remove('active');
					});
				} else {
					htmlRow.style.display = 'none';
				}
			});

			triggerTransition();
		});
	});

	subFilters.forEach(filter => {
		filter.addEventListener('click', (e) => {
			const clickedPill = e.target as HTMLButtonElement;
			const parentRow = clickedPill.closest('.sub-filter-pills');
			parentRow.querySelectorAll('.sub-filter').forEach(f => f.classList.remove('active'));
			clickedPill.classList.add('active');

			activeSubcategory = clickedPill.dataset.subfilter;
			triggerTransition();
		});
	});

	savedToggle?.addEventListener('click', () => {
		isSavedViewActive = !isSavedViewActive;
		if (isSavedViewActive) {
			savedToggle.classList.add('active');
		} else {
			savedToggle.classList.remove('active');
		}
		triggerTransition();
	});

	window.saveCard = async (element) => {
		let pin = localStorage.getItem('naf_admin_pin');
		if (!pin) {
			pin = prompt("Enter Admin PIN to authorize saving:");
			if (!pin) return;
			localStorage.setItem('naf_admin_pin', pin);
		}

		const btn = element.querySelector('.save-btn');
		const svg = btn.querySelector('svg');
		
		const isCurrentlySaved = svg.style.fill === 'var(--aros-primary)' || 
		                         svg.getAttribute('fill') === 'var(--aros-primary)' || 
		                         element.dataset.category === 'saved';
		                         
		const method = isCurrentlySaved ? 'DELETE' : 'POST';
		
		try {
			const payload = JSON.parse(decodeURIComponent(element.dataset.payload));
			const res = await fetch('/api/saved', {
				method: method,
				headers: {
					'Content-Type': 'application/json',
					'Authorization': `Bearer ${pin}`
				},
				body: JSON.stringify(payload)
			});
			if (!res.ok) {
				if (res.status === 401) {
					localStorage.removeItem('naf_admin_pin');
					alert("Invalid PIN. Please try again.");
				}
				throw new Error("Failed to save");
			}
			
			if (isCurrentlySaved) {
			    svg.style.fill = 'none';
			    if (isSavedViewActive && element.dataset.isSavedCard === 'true') {
			        element.style.display = 'none'; // Hide it visually immediately from the saved view
			    }
			} else {
			    svg.style.fill = 'var(--aros-primary)';
			    svg.style.stroke = 'var(--aros-primary)';
			}
		} catch (e) {
			console.error(e);
			svg.style.stroke = 'red';
		}
	};

	window.loadSavedCards = async () => {
		let pin = localStorage.getItem('naf_admin_pin');
		if (!pin) {
			pin = prompt("Enter Admin PIN to view saved cards:");
			if (!pin) return;
			localStorage.setItem('naf_admin_pin', pin);
		}

		try {
			const res = await fetch('/api/saved', {
				headers: { 'Authorization': `Bearer ${pin}` }
			});
			if (!res.ok) return;
			const cards = await res.json();
			
			const grid = document.querySelector('.reel-feed');
			if (!grid) return;
			
			// Remove previously injected saved cards
			document.querySelectorAll('.reel-item[data-category="saved"]').forEach(el => el.remove());
			
			cards.forEach((item, i) => {
				const li = document.createElement('li');
				li.className = `reel-item type-${item.type}`;
				li.dataset.category = item.category;
				li.dataset.subcategory = item.subcategory;
				li.dataset.isSavedCard = 'true';
				li.dataset.payload = encodeURIComponent(JSON.stringify(item));
				
				const d = item.data;
				let innerHTML = '';
				
				const saveBtnHTML = `<button class="save-btn" title="Unsave" onclick="window.saveCard(this.closest('.reel-item'))"><svg viewBox="0 0 24 24" width="24" height="24" stroke="var(--aros-primary)" stroke-width="2" fill="var(--aros-primary)"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg></button>`;
				
				if (item.type === 'news') {
					innerHTML = `<div class="reel-card-wrapper">${saveBtnHTML}<a href="${d.link}" target="_blank" rel="noopener noreferrer" class="news-card sound-trigger"><div class="content-overlay"><div class="meta"><span class="source">${d.source}</span><span class="date">${d.date}</span></div><h3>${d.title}</h3></div></a></div>`;
				}
				if (item.type === 'dev') {
					innerHTML = `<div class="reel-card-wrapper">${saveBtnHTML}<a href="${d.url}" target="_blank" rel="noopener noreferrer" class="dev-card sound-trigger"><div class="content-overlay"><div class="card-header"><span class="author">${d.author}</span><span class="reactions">❤️ ${d.reactions}</span></div><h3>${d.title}</h3></div></a></div>`;
				}
				if (item.type === 'github') {
					innerHTML = `<div class="reel-card-wrapper">${saveBtnHTML}<a href="${d.html_url}" target="_blank" rel="noopener noreferrer" class="repo-card sound-trigger"><div class="content-overlay"><div class="card-header"><span class="language">${d.language}</span><span class="stars">⭐ ${d.stargazers_count}</span></div><h3>${d.full_name}</h3><p>${d.description || ''}</p></div></a></div>`;
				}
				if (item.type === 'chrome') {
					const statusText = d.browsers?.chrome?.status?.text || "In Development";
					innerHTML = `<div class="reel-card-wrapper">${saveBtnHTML}<a href="https://chromestatus.com/feature/${d.id}" target="_blank" rel="noopener noreferrer" class="feature-card sound-trigger"><div class="content-overlay"><div class="card-header"><span class="category-badge">${d.category}</span><span class="status-indicator"><span class="pulse"></span>${statusText}</span></div><h3>${d.name}</h3><p>${d.summary}</p></div></a></div>`;
				}
				
				li.innerHTML = innerHTML;
				grid.appendChild(li);
			});
		} catch(e) { console.error(e); }
	};

	const feed = document.querySelector('.reel-feed');
	if (feed && window.matchMedia('(hover: hover)').matches) {
		let rafId = null;

		feed.addEventListener('mousemove', (e) => {
			const item = (e.target as HTMLElement).closest('.reel-item');
			if (!item || item.classList.contains('intro-slide')) return;

			if (rafId) cancelAnimationFrame(rafId);

			rafId = requestAnimationFrame(() => {
				const rect = item.getBoundingClientRect();
				const x = (e.clientX - rect.left) / rect.width;
				const y = (e.clientY - rect.top) / rect.height;

				const rotateY = (x - 0.5) * 10; 
				const rotateX = (0.5 - y) * 10;

				const wrapper = item.querySelector('.reel-card-wrapper') as HTMLElement;
				if (wrapper) {
					wrapper.style.setProperty('--mouse-x', `${x * 100}%`);
					wrapper.style.setProperty('--mouse-y', `${y * 100}%`);
					wrapper.style.setProperty('--rotate-x', `${rotateX}deg`);
					wrapper.style.setProperty('--rotate-y', `${rotateY}deg`);
					wrapper.style.setProperty('--scale', `1.02`);
				}
			});
		});

		feed.addEventListener('mouseout', (e) => {
			const item = (e.target as HTMLElement).closest('.reel-item');
			if (!item || item.classList.contains('intro-slide')) return;
			
			const relatedTarget = e.relatedTarget as HTMLElement;
			if (relatedTarget && item.contains(relatedTarget)) return;

			if (rafId) cancelAnimationFrame(rafId);
			const wrapper = item.querySelector('.reel-card-wrapper') as HTMLElement;
			if (wrapper) {
				wrapper.style.setProperty('--rotate-x', `0deg`);
				wrapper.style.setProperty('--rotate-y', `0deg`);
				wrapper.style.setProperty('--scale', `1`);
			}
		});
	}
</script>

<style is:global>
	.dashboard {
		max-width: 1300px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}

	.hero {
		text-align: center;
		margin-bottom: 3rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.badge {
		display: inline-block;
		padding: 0.3rem 0.75rem;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--border-color);
		border-radius: 9999px;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		margin-bottom: 1.5rem;
	}

	h1 {
		font-size: 4.5rem;
		font-weight: 700;
		line-height: 1.1;
		margin: 0;
	}

	.hero p {
