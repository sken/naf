---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import ReelItem from '../components/ReelItem.astro';
import TrendCard from '../components/TrendCard.astro';
import HubLogo from '../components/HubLogo.astro';
import Parser from 'rss-parser';
import * as cheerio from 'cheerio';
import config from '../../hub.config.json';
import { normalizeCard, safeUrl, type Card, type CardType } from '../lib/cards';

const FETCH_TIMEOUT_MS = 15_000;
const USER_AGENT = 'Astro-Dashboard';

const fetchWithTimeout = (url: string, init: RequestInit = {}) =>
	fetch(url, { ...init, signal: AbortSignal.timeout(FETCH_TIMEOUT_MS) });

async function fetchOk(url: string, init: RequestInit = {}) {
	const res = await fetchWithTimeout(url, init);
	if (!res.ok) throw new Error(`HTTP ${res.status}`);
	return res;
}

// Each source is fetched independently and in parallel; a failing source is logged and yields [].
async function fromSource<T>(name: string, load: () => Promise<T[]>): Promise<T[]> {
	try {
		return await load();
	} catch (e) {
		console.warn(`[hub] ${name} failed: ${e instanceof Error ? e.message : e}`);
		return [];
	}
}

// 1. Chrome Status features
const loadFeatures = () => fromSource('Chrome Status', async () => {
	let text = await (await fetchOk(config.endpoints.chromeStatus)).text();
	if (text.startsWith(")]}'")) text = text.substring(4).trim();
	const data = JSON.parse(text);
	if (!Array.isArray(data?.features)) return [];
	return data.features.slice(0, config.limits.chromeFeatures).map((f: any) => ({
		id: f.id,
		name: f.name,
		summary: f.summary,
		category: f.category,
		status: f.browsers?.chrome?.status?.text || 'In Development',
	}));
});

// 2. RSS feeds, with "Fair Representation"
interface NewsEntry { time: number; data: { title: string; link: string; date: string; source: string } }

// Exclude Cyrillic, CJK, Arabic, etc.
const nonEngChars = /[぀-ヿ㐀-䶿一-鿿Ѐ-ӿ؀-ۿ]/;
// Common Spanish, Portuguese, German and French stopwords that are not also English words
const foreignWords = /\b(como|para|el|la|en|que|los|las|una|con|por|uma|da|na|der|das|les|des)\b/gi;
// Clickbait and spam filters
const clickbait = /\b(jasa|top \d+|stop using|you need to)\b/i;

function isHighSignalMediumItem(item: Parser.Item): boolean {
	if (!item.title) return false;
	if (nonEngChars.test(item.title)) return false;

	// Drop ALL CAPS SPAM (e.g., JASA WEBSITE...)
	const lettersOnly = item.title.replace(/[^a-zA-Z]/g, '');
	if (lettersOnly.length > 10 && lettersOnly === lettersOnly.toUpperCase()) return false;

	if (clickbait.test(item.title)) return false;

	// Reject if title has multiple foreign stop words
	if ((item.title.match(foreignWords) || []).length >= 2) return false;

	// Member-only posts only ship a short teaser in the feed; drop them
	const content = (item as any)['content:encoded'] || item.content || item.contentSnippet || '';
	const wordCount = content.replace(/<[^>]*>?/gm, ' ').trim().split(/\s+/).length;
	return wordCount >= 500;
}

const isPromo = (title: string) => /coupon|promo|codes/i.test(title);

const loadNews = async (): Promise<NewsEntry[]> => {
	const parser = new Parser({ timeout: FETCH_TIMEOUT_MS, headers: { 'User-Agent': USER_AGENT } });

	const perSource = await Promise.all(config.rssSources.map(source => fromSource(source.name, async () => {
		const feed = await parser.parseURL(source.url);
		let items = feed.items;
		if (source.name.includes('Wired')) items = items.filter(item => item.title && !isPromo(item.title));
		if (source.name.startsWith('Medium')) items = items.filter(isHighSignalMediumItem);

		const entries: NewsEntry[] = [];
		for (const item of items) {
			const link = safeUrl(item.link);
			if (!link || !item.title) continue;
			const pubDate = new Date(item.isoDate || item.pubDate || '');
			const valid = !Number.isNaN(pubDate.getTime());
			entries.push({
				time: valid ? pubDate.getTime() : 0,
				data: {
					title: item.title.trim(),
					link,
					date: valid ? pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '',
					source: source.name,
				},
			});
		}
		return entries.sort((a, b) => b.time - a.time);
	})));

	// Guarantee the 2 newest items from every successful source, then fill the remaining
	// quota chronologically while capping each source so high-volume publishers can't dominate.
	const seen = new Set<string>();
	const counts = new Map<string, number>();
	const selected: NewsEntry[] = [];
	const take = (entry: NewsEntry) => {
		if (seen.has(entry.data.link)) return;
		seen.add(entry.data.link);
		counts.set(entry.data.source, (counts.get(entry.data.source) ?? 0) + 1);
		selected.push(entry);
	};

	perSource.forEach(entries => entries.slice(0, 2).forEach(take));

	const pool = perSource.flatMap(entries => entries.slice(2)).sort((a, b) => b.time - a.time);
	for (const entry of pool) {
		if (selected.length >= config.limits.rssNews) break;
		if ((counts.get(entry.data.source) ?? 0) >= config.limits.rssMaxPerSource) continue;
		take(entry);
	}

	return selected.sort((a, b) => b.time - a.time);
};

// 3. GitHub Trending (scraped) and the configured user's starred repos
const loadTrending = () => fromSource('GitHub Trending', async () => {
	const html = await (await fetchOk(config.endpoints.githubTrending, { headers: { 'User-Agent': USER_AGENT } })).text();
	const $ = cheerio.load(html);
	return $('article.Box-row').toArray().slice(0, config.limits.githubTrending).map(el => {
		const fullName = $(el).find('h2 a').text().replace(/\s+/g, '').trim();
		const starsStr = $(el).find('a[href$="/stargazers"]').first().text().trim().replace(/,/g, '');
		return {
			full_name: fullName,
			html_url: `https://github.com/${fullName}`,
			description: $(el).find('p').text().trim(),
			language: $(el).find('[itemprop="programmingLanguage"]').text().trim(),
			stargazers_count: parseInt(starsStr, 10) || 0,
		};
	});
});

const loadStarred = () => fromSource('GitHub stars', async () => {
	// An optional GITHUB_TOKEN raises the API rate limit from 60 to 5,000 requests/hour
	const url = `https://api.github.com/users/${config.githubUser}/starred`;
	const token = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN;
	let res = await fetchWithTimeout(url, { headers: { 'User-Agent': USER_AGENT, ...(token && { Authorization: `Bearer ${token}` }) } });
	// A rejected token should never be worse than no token at all
	if (res.status === 401 && token) {
		console.warn('[hub] GITHUB_TOKEN was rejected; retrying unauthenticated');
		res = await fetchWithTimeout(url, { headers: { 'User-Agent': USER_AGENT } });
	}
	if (!res.ok) throw new Error(`HTTP ${res.status}`);
	const repos: any[] = await res.json();
	return repos.slice(0, config.limits.githubStarred).map(repo => ({
		full_name: repo.full_name,
		html_url: repo.html_url,
		description: repo.description,
		language: repo.language || 'Unknown',
		stargazers_count: repo.stargazers_count,
		isStarred: true,
	}));
});

// 4. Dev.to trending articles
const loadDevTo = () => fromSource('Dev.to', async () => {
	const articles: any[] = await (await fetchOk(config.endpoints.devTo)).json();
	return articles.slice(0, config.limits.devToArticles).map(article => ({
		title: article.title,
		url: article.url,
		reactions: article.positive_reactions_count,
		author: article.user?.name,
	}));
});

// 5. NPM weekly downloads
const loadNpmStats = async () => {
	const stats = await Promise.all(config.frameworks.map(framework => fromSource(`npm ${framework}`, async () => {
		const data = await (await fetchOk(`${config.endpoints.npmDownloads}${framework}`)).json();
		return [{ framework: data.package as string, downloads: data.downloads as number }];
	})));
	return stats.flat().sort((a, b) => b.downloads - a.downloads);
};

const [features, newsItems, trendingRepos, starredRepos, devItems, npmStats] = await Promise.all([
	loadFeatures(), loadNews(), loadTrending(), loadStarred(), loadDevTo(), loadNpmStats(),
]);

const subcategoryOf = (sourceName: string) =>
	sourceName.includes('Medium') ? 'medium' : sourceName.toLowerCase().replace(/[^a-z0-9]/g, '');

// Every card goes through the same validation as the /api/saved endpoint (URL scheme checks, field whitelist)
const toCards = (type: CardType, rows: any[], subcategory: (row: any) => string) =>
	rows.map(data => normalizeCard({ type, subcategory: subcategory(data), data })).filter((card): card is Card => card !== null);

const regularCards = [
	...toCards('news', newsItems.map(n => n.data), n => subcategoryOf(n.source)),
	...toCards('github', trendingRepos, () => 'trending'),
	...toCards('chrome', features, () => 'all'),
	...toCards('dev', devItems, () => 'devto'),
];
const starredCards = toCards('github', starredRepos, () => 'starred');

// Fisher–Yates shuffle (fresh order on every build)
for (let i = regularCards.length - 1; i > 0; i--) {
	const j = Math.floor(Math.random() * (i + 1));
	[regularCards[i], regularCards[j]] = [regularCards[j], regularCards[i]];
}

// Ensure starred repos are always prominently placed near the top of the feed
const feedCards = [...regularCards];
starredCards.forEach((card, i) => {
	feedCards.splice(Math.floor(Math.random() * (i + 5)), 0, card);
});

// Empty cards rendered into <template>s; the client clones these to display saved cards
const templateCards: Card[] = [
	{ type: 'news', category: 'articles', subcategory: '', data: { title: '', link: '', date: '', source: '' } },
	{ type: 'dev', category: 'articles', subcategory: '', data: { title: '', url: '', reactions: 0, author: '' } },
	{ type: 'github', category: 'repos', subcategory: '', data: { full_name: '', html_url: '', description: '', language: '', stargazers_count: 0 } },
	{ type: 'chrome', category: 'platform', subcategory: '', data: { id: '0', name: '', summary: '', category: '', status: '' } },
];

const buildTime = new Date().toLocaleString('en-US', {
	month: 'short',
	day: 'numeric',
	hour: 'numeric',
	minute: '2-digit',
	timeZoneName: 'short'
});
---

<Layout title="Hub by Stefan Kendlbacher | Web Trends Dashboard">
	<main class="dashboard">

		<!-- SVG filter used by the wobbly dotted card borders -->
		<svg width="0" height="0" style="position:absolute; width:0; height:0;" aria-hidden="true">
			<filter id="wobbly-border">
				<feTurbulence type="fractalNoise" baseFrequency="0.08" numOctaves="2" result="noise" />
				<feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G" />
			</filter>
		</svg>

		<!-- Unified Master Filter -->
		<ul role="list" class="reel-feed">
			<!-- Intro Slide with Hero and Filters -->
			<li class="reel-item intro-slide">
				<header class="hero">
					<div class="badge">hub.skendlba.dev &bull; Updated {buildTime}</div>
					<h1><HubLogo /></h1>
					<p>All the frontend signals you (or at least me) care about, minus the 45 open browser tabs.</p>
				</header>

				<div class="filter-container">
					<div class="filter-header">
						<div class="filter-pills">
							<button class="master-filter active sound-trigger" data-filter="all">All Signals</button>
							<button class="master-filter filter-articles sound-trigger" data-filter="articles">Articles</button>
							<button class="master-filter filter-repos sound-trigger" data-filter="repos">Repositories</button>
							<button class="master-filter filter-platform sound-trigger" data-filter="platform">Platform Updates</button>
						</div>
						<button class="saved-toggle sound-trigger" id="savedToggle" title="View Saved Cards" aria-pressed="false">
							<svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
							Saved
						</button>
					</div>

					<div class="sub-filter-pills" data-parent="articles" style="display: none;">
						<button class="sub-filter active sound-trigger" data-subfilter="all">All Articles</button>
						<button class="sub-filter sound-trigger" data-subfilter="devto">Dev.to</button>
						<button class="sub-filter sound-trigger" data-subfilter="medium">Medium</button>
						{Array.from(new Set(config.rssSources.filter(s => !s.name.includes('Medium')).map(s => s.name))).map(name => (
							<button class="sub-filter sound-trigger" data-subfilter={subcategoryOf(name)}>{name}</button>
						))}
					</div>
					<div class="sub-filter-pills" data-parent="repos" style="display: none;">
						<button class="sub-filter active sound-trigger" data-subfilter="all">All Repos</button>
						<button class="sub-filter sound-trigger" data-subfilter="trending">Trending</button>
						<button class="sub-filter sound-trigger" data-subfilter="starred">My Stars</button>
					</div>
				</div>
			</li>

			<!-- Reel Items Canvas -->
			{feedCards.map(card => <ReelItem card={card} />)}
		</ul>

		{templateCards.map(card => (
			<template data-card-template={card.type}><ReelItem card={card} /></template>
		))}

		<!-- Framework Stats Footer -->
		<section class="stats-footer">
			<h2>Weekly Framework Adoption</h2>
			<ul role="list" class="footer-bento">
				{npmStats.map(stat => (
					<li class="bento-item type-npm">
						<TrendCard framework={stat.framework} downloads={stat.downloads} />
					</li>
				))}
			</ul>
		</section>
	</main>
</Layout>

<script>
	import { chromeFeatureUrl, getCardKey, safeUrl, type Card } from '../lib/cards';

	// Legacy key from before the rename to Hub; kept so stored PINs keep working
	const PIN_STORAGE_KEY = 'naf_admin_pin';
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const feed = document.querySelector<HTMLUListElement>('.reel-feed')!;
	const filters = document.querySelectorAll<HTMLButtonElement>('.master-filter');
	const subFilters = document.querySelectorAll<HTMLButtonElement>('.sub-filter');
	const subFilterRows = document.querySelectorAll<HTMLElement>('.sub-filter-pills');
	const savedToggle = document.getElementById('savedToggle') as HTMLButtonElement;

	let activeCategory = 'all';
	let activeSubcategory = 'all';
	let isSavedViewActive = false;
	let savedCards: Card[] = [];
	const savedKeys = new Set<string>();

	// ---- Admin PIN ----------------------------------------------------------------

	const storage = {
		get: () => { try { return localStorage.getItem(PIN_STORAGE_KEY); } catch { return null; } },
		set: (pin: string) => { try { localStorage.setItem(PIN_STORAGE_KEY, pin); } catch {} },
		clear: () => { try { localStorage.removeItem(PIN_STORAGE_KEY); } catch {} },
	};

	function getPin(promptText: string | null): string | null {
		const stored = storage.get();
		if (stored || !promptText) return stored;
		const pin = prompt(promptText);
		if (pin) storage.set(pin);
		return pin || null;
	}

	/** Calls /api/saved; returns null (after informing the user) on auth or network failure. */
	async function savedApi(method: 'GET' | 'POST' | 'DELETE', pin: string, body?: unknown): Promise<Response | null> {
		const res = await fetch('/api/saved', {
			method,
			headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${pin}` },
			body: body === undefined ? undefined : JSON.stringify(body),
		}).catch(() => null);

		if (res?.status === 401) {
			storage.clear();
			alert('Invalid PIN. Please try again.');
		} else if (res?.status === 429) {
			alert('Too many failed attempts. Please wait a few minutes.');
		}
		return res?.ok ? res : null;
	}

	// ---- Saved state ------------------------------------------------------------------

	function syncSaveButtons() {
		feed.querySelectorAll<HTMLElement>('.reel-item[data-key]').forEach(item => {
			const saved = savedKeys.has(item.dataset.key!);
			const btn = item.querySelector<HTMLButtonElement>('.save-btn');
			if (!btn) return;
			btn.setAttribute('aria-pressed', String(saved));
			btn.setAttribute('aria-label', saved ? 'Remove from saved' : 'Save card');
			btn.title = saved ? 'Remove from saved' : 'Save this card';
		});
	}

	async function loadSaved(promptText: string | null): Promise<boolean> {
		const pin = getPin(promptText);
		if (!pin) return false;
		const res = await savedApi('GET', pin);
		if (!res) return false;
		savedCards = await res.json();
		savedKeys.clear();
		savedCards.forEach(card => {
			const key = getCardKey(card);
			if (key) savedKeys.add(key);
		});
		syncSaveButtons();
		return true;
	}

	async function toggleSave(item: HTMLElement) {
		const btn = item.querySelector<HTMLButtonElement>('.save-btn');
		const key = item.dataset.key;
		const pin = getPin('Enter Admin PIN to authorize saving:');
		if (!btn || !key || !pin) return;

		if (btn.disabled) return;
		const card: Card = JSON.parse(decodeURIComponent(item.dataset.payload!));
		const wasSaved = savedKeys.has(key);
		btn.classList.remove('has-error');

		btn.disabled = true;
		const res = await savedApi(wasSaved ? 'DELETE' : 'POST', pin, card);
		btn.disabled = false;
		if (!res) {
			btn.classList.add('has-error');
			return;
		}

		if (wasSaved) {
			savedKeys.delete(key);
			savedCards = savedCards.filter(c => getCardKey(c) !== key);
			if (item.dataset.isSavedCard === 'true') transition(() => item.remove());
		} else {
			savedKeys.add(key);
			savedCards.unshift(card);
		}
		syncSaveButtons();
	}

	// ---- Saved card rendering (cloned from server-rendered <template>s) -----------

	function setText(root: Element, selector: string, value: unknown) {
		const el = root.querySelector(selector);
		if (el) el.textContent = value == null ? '' : String(value);
	}

	function renderSavedCard(card: Card): HTMLElement | null {
		const template = document.querySelector<HTMLTemplateElement>(`template[data-card-template="${card.type}"]`);
		const li = template?.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
		const key = getCardKey(card);
		if (!li || !key) return null;

		li.dataset.category = card.category;
		li.dataset.subcategory = card.subcategory;
		li.dataset.key = key;
		li.dataset.payload = encodeURIComponent(JSON.stringify(card));
		li.dataset.isSavedCard = 'true';

		let href: string | null = null;
		switch (card.type) {
			case 'news':
				href = safeUrl(card.data.link);
				setText(li, '.source', card.data.source);
				setText(li, '.date', card.data.date);
				setText(li, 'h3', card.data.title);
				break;
			case 'dev':
				href = safeUrl(card.data.url);
				setText(li, '.reactions', `❤️ ${card.data.reactions}`);
				setText(li, '.author', `by ${card.data.author}`);
				setText(li, 'h3', card.data.title);
				break;
			case 'github':
				href = safeUrl(card.data.html_url);
				setText(li, '.category-badge', card.data.language || 'Code');
				setText(li, '.stars', `${new Intl.NumberFormat('en-US').format(card.data.stargazers_count)} Stars`);
				setText(li, 'h3', card.data.full_name);
				setText(li, 'p', card.data.description || 'No description provided.');
				break;
			case 'chrome':
				href = chromeFeatureUrl(card.data.id);
				setText(li, '.category-badge', card.data.category || 'General');
				setText(li, '.status-text', card.data.status);
				setText(li, 'h3', card.data.name);
				setText(li, 'p', card.data.summary);
				break;
		}

		const link = li.querySelector('a');
		if (!href || !link) return null;
		link.href = href;
		return li;
	}

	function removeSavedCards() {
		feed.querySelectorAll('.reel-item[data-is-saved-card="true"]').forEach(el => el.remove());
	}

	function renderSavedCards() {
		removeSavedCards();
		savedCards.forEach(card => {
			const li = renderSavedCard(card);
			if (li) feed.appendChild(li);
		});
		syncSaveButtons();
	}

	// ---- Filtering ----------------------------------------------------------------------

	function applyFilters() {
		feed.querySelectorAll<HTMLElement>('.reel-item:not(.intro-slide)').forEach(item => {
			const catMatch = activeCategory === 'all' || item.dataset.category === activeCategory;
			const subMatch = activeCategory === 'all' || activeSubcategory === 'all' || item.dataset.subcategory === activeSubcategory;
			const viewMatch = isSavedViewActive === (item.dataset.isSavedCard === 'true');
			item.style.display = catMatch && subMatch && viewMatch ? 'flex' : 'none';
		});
	}

	function transition(update: () => void) {
		if (document.startViewTransition && !prefersReducedMotion) {
			document.startViewTransition(update);
		} else {
			update();
		}
	}

	filters.forEach(filter => {
		filter.addEventListener('click', () => {
			filters.forEach(f => f.classList.remove('active'));
			filter.classList.add('active');

			activeCategory = filter.dataset.filter ?? 'all';
			activeSubcategory = 'all';

			subFilterRows.forEach(row => {
				const isActiveRow = row.dataset.parent === activeCategory;
				row.style.display = isActiveRow ? 'flex' : 'none';
				if (isActiveRow) {
					// Reset visual active state to "All"
					row.querySelectorAll<HTMLElement>('.sub-filter').forEach(btn => {
						btn.classList.toggle('active', btn.dataset.subfilter === 'all');
					});
				}
			});

			transition(applyFilters);
		});
	});

	subFilters.forEach(filter => {
		filter.addEventListener('click', () => {
			filter.closest('.sub-filter-pills')?.querySelectorAll('.sub-filter').forEach(f => f.classList.remove('active'));
			filter.classList.add('active');
			activeSubcategory = filter.dataset.subfilter ?? 'all';
			transition(applyFilters);
		});
	});

	savedToggle.addEventListener('click', async () => {
		if (!isSavedViewActive) {
			if (!(await loadSaved('Enter Admin PIN to view saved cards:'))) return;
			isSavedViewActive = true;
			transition(() => { renderSavedCards(); applyFilters(); });
		} else {
			isSavedViewActive = false;
			transition(() => { removeSavedCards(); applyFilters(); });
		}
		savedToggle.classList.toggle('active', isSavedViewActive);
		savedToggle.setAttribute('aria-pressed', String(isSavedViewActive));
	});

	// Save buttons (static and injected cards) via event delegation
	feed.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest('.save-btn');
		const item = btn?.closest<HTMLElement>('.reel-item');
		if (item) toggleSave(item);
	});

	// Reflect already-saved cards on load when the admin PIN is known (never prompts)
	if (storage.get()) loadSaved(null);

	// ---- 3D tilt + glow ---------------------------------------------------------------------

	if (window.matchMedia('(hover: hover)').matches && !prefersReducedMotion) {
		let rafId: number | null = null;

		feed.addEventListener('mousemove', (e: MouseEvent) => {
			const item = (e.target as HTMLElement).closest('.reel-item');
			if (!item || item.classList.contains('intro-slide')) return;

			if (rafId) cancelAnimationFrame(rafId);

			rafId = requestAnimationFrame(() => {
				const rect = item.getBoundingClientRect();
				const x = (e.clientX - rect.left) / rect.width;
				const y = (e.clientY - rect.top) / rect.height;

				const rotateY = (x - 0.5) * 10;
				const rotateX = (0.5 - y) * 10;

				const wrapper = item.querySelector<HTMLElement>('.reel-card-wrapper');
				if (wrapper) {
					wrapper.style.setProperty('--mouse-x', `${x * 100}%`);
					wrapper.style.setProperty('--mouse-y', `${y * 100}%`);
					wrapper.style.setProperty('--rotate-x', `${rotateX}deg`);
					wrapper.style.setProperty('--rotate-y', `${rotateY}deg`);
					wrapper.style.setProperty('--scale', `1.02`);
				}
			});
		});

		feed.addEventListener('mouseout', (e: MouseEvent) => {
			const item = (e.target as HTMLElement).closest('.reel-item');
			if (!item || item.classList.contains('intro-slide')) return;

			const relatedTarget = e.relatedTarget as HTMLElement | null;
			if (relatedTarget && item.contains(relatedTarget)) return;

			if (rafId) cancelAnimationFrame(rafId);
			const wrapper = item.querySelector<HTMLElement>('.reel-card-wrapper');
			if (wrapper) {
				wrapper.style.setProperty('--rotate-x', `0deg`);
				wrapper.style.setProperty('--rotate-y', `0deg`);
				wrapper.style.setProperty('--scale', `1`);
			}
		});
	}
</script>

