---
interface Props {
	title: string;
	description?: string;
	author?: string;
}

const { 
	title, 
	description = "A unified dashboard of industry insights, platform features, and emerging web trends.",
	author = "Stefan Kendlbacher" 
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={author} />
		<meta name="keywords" content="Stefan Kendlbacher, Web Trends, Frontend Development, Developer Dashboard, Hub" />
		<link rel="canonical" href={`https://hub.skendlba.dev${Astro.url.pathname}`} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={`https://hub.skendlba.dev${Astro.url.pathname}`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Hub by Stefan Kendlbacher" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={`https://hub.skendlba.dev${Astro.url.pathname}`} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />

		<!-- JSON-LD Structured Data for Person/Creator -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": title,
			"url": "https://hub.skendlba.dev",
			"description": description,
			"author": {
				"@type": "Person",
				"name": author,
				"url": "https://skendlba.dev"
			}
		})} />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
		
		<script>
			// UI Sound System (Godly.website style)
			let audioCtx: AudioContext | null = null;

			function initAudio() {
				if (!audioCtx) {
					audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
				}
				if (audioCtx.state === 'suspended') {
					audioCtx.resume();
				}
			}

			function playTick() {
				if (!audioCtx) return;
				const osc = audioCtx.createOscillator();
				const gain = audioCtx.createGain();
				osc.connect(gain);
				gain.connect(audioCtx.destination);
				osc.type = 'sine';
				osc.frequency.setValueAtTime(800, audioCtx.currentTime);
				osc.frequency.exponentialRampToValueAtTime(300, audioCtx.currentTime + 0.05);
				gain.gain.setValueAtTime(0.02, audioCtx.currentTime);
				gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.05);
				osc.start();
				osc.stop(audioCtx.currentTime + 0.05);
			}

			function playPop() {
				if (!audioCtx) return;
				const osc = audioCtx.createOscillator();
				const gain = audioCtx.createGain();
				osc.connect(gain);
				gain.connect(audioCtx.destination);
				osc.type = 'triangle';
				osc.frequency.setValueAtTime(300, audioCtx.currentTime);
				osc.frequency.exponentialRampToValueAtTime(100, audioCtx.currentTime + 0.1);
				gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
				gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.1);
				osc.start();
				osc.stop(audioCtx.currentTime + 0.1);
			}

			// Initialize on first user interaction to comply with browser autoplay policies
			document.addEventListener('click', initAudio, { once: true });
			document.addEventListener('keydown', initAudio, { once: true });

			// Keep track of elements we've already attached to
			const attachedElements = new WeakSet();

			function attachSounds() {
				document.querySelectorAll('.sound-trigger, .filter-pill, .feature-card').forEach(el => {
					if (!attachedElements.has(el)) {
						el.addEventListener('mouseenter', playTick);
						el.addEventListener('mousedown', playPop);
						attachedElements.add(el);
					}
				});
			}

			// Run on load
			document.addEventListener('DOMContentLoaded', attachSounds);
			
			// Observer for dynamic elements
			const observer = new MutationObserver(() => {
				attachSounds();
			});
			observer.observe(document.body, { childList: true, subtree: true });
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg-color: #FAFAFA;
		--surface-color: #FFFFFF;
		--surface-hover: #F0F0F0;
		--border-color: rgba(0, 0, 0, 0.08);
		--border-hover: rgba(0, 0, 0, 0.2);
		--text-primary: #1A1A1A;
		--text-secondary: #666666;
		--vercel-shadow: 0 4px 12px rgba(0, 0, 0, 0.05);

		/* Aarhus Color Palettes */
		/* Palette 1: Rainbow & Concrete (ARoS Modernism) */
		--aros-primary: #E07A5F;
		--aros-secondary: #F2CC8F;
		--aros-accent: #8ECAE6;
		--aros-bg: #F8F6F0;
		--aros-text: #2B2D42;

		/* Palette 2: Møllestien & Den Gamle By (Historic Heritage) */
		--heritage-primary: #D48C84;
		--heritage-secondary: #A3B18A;
		--heritage-accent: #E0A96D;
		--heritage-bg: #F4F1DE;
		--heritage-text: #3D405B;

		/* Palette 3: Dokk1 & The Bay (Nordic Coastal Minimalism) */
		--coastal-primary: #2A6F97;
		--coastal-secondary: #A8DADC;
		--coastal-accent: #E9C46A;
		--coastal-bg: #F1FAEE;
		--coastal-text: #1D3557;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html, body {
		width: 100%;
		min-height: 100vh;
		background-color: var(--bg-color);
		background-image: url("data:image/svg+xml,%3Csvg width='400' height='400' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%231A1A24' opacity='0.04'%3E%3Ccircle cx='20' cy='30' r='1.5'/%3E%3Ccircle cx='180' cy='90' r='1'/%3E%3Ccircle cx='350' cy='40' r='2'/%3E%3Ccircle cx='250' cy='160' r='1.5'/%3E%3Ccircle cx='80' cy='220' r='1'/%3E%3Ccircle cx='320' cy='280' r='2'/%3E%3Ccircle cx='150' cy='340' r='1'/%3E%3Ccircle cx='10' cy='390' r='1.5'/%3E%3Ccircle cx='380' cy='210' r='1.5'/%3E%3Ccircle cx='190' cy='380' r='1'/%3E%3Ccircle cx='100' cy='150' r='2'/%3E%3Ccircle cx='290' cy='80' r='1'/%3E%3C/g%3E%3C/svg%3E");
		color: var(--text-primary);
		font-family: 'Inter', sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: 'Inter', sans-serif;
		letter-spacing: -0.03em;
		font-weight: 600;
	}

	/* Accessibility: Focus Outlines */
	*:focus-visible {
		outline: 2px solid var(--text-primary);
		outline-offset: 2px;
	}

	/* Custom Scrollbar */
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: var(--bg-color); 
	}
	::-webkit-scrollbar-thumb {
		background: rgba(0, 0, 0, 0.15); 
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: rgba(0, 0, 0, 0.25); 
	}
</style>
